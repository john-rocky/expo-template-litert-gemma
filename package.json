    "react-native-litert-lm": "0.8.2",
    "react-native-nitro-modules": "0.37.1",
    "react-native-safe-area-context": "~5.11.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
